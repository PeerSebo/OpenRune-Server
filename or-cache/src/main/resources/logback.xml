<?xml version="1.0" encoding="UTF-8"?>

<configuration>
  <!-- The classpath includes both resources and the jar; suppress duplicate-config status output. -->
  <statusListener class="ch.qos.logback.core.status.NopStatusListener" />

  <!-- Share stderr with the progress bar so redraws and logs remain ordered. -->
  <appender name="STDOUT" class="dev.openrune.BarAwareAppender">
    <target>System.err</target>
    <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
      <pattern>%d{HH:mm:ss} [%level] - %msg%n</pattern>
      <charset>utf8</charset>
    </encoder>
  </appender>

  <root level="INFO">
    <appender-ref ref="STDOUT" />
  </root>


  <logger name="io.netty" level="WARN" additivity="false" />


  <logger name="dev.openrune.cache.filestore.definition" level="WARN" />

  <!-- Set DEBUG to diagnose incremental repacking. -->
  <logger name="dev.openrune.cache.tools.incremental" level="INFO" />


  <logger name="dev.openrune.filesystem.util.compress" level="WARN" />
  <logger name="org.openrs2.compress.bzip2" level="WARN" additivity="false" />
</configuration>
